{
  "name": "grove-git",
  "version": "1.0.0",
  "private": true,
  "description": "A thoughtful desktop home for your Git repositories.",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "node scripts/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "package": "npm run build && electron-builder --mac dir --config.electronDist=node_modules/electron/dist",
    "format": "prettier --write src desktop tests scripts/*.mjs *.json *.ts *.html README.md"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.7",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  },
  "build": {
    "appId": "dev.grove.git",
    "productName": "Grove",
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "icon": "build/icon.png"
    }
  }
}
